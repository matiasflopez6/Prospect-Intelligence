# Copia este archivo a .env.local y completa los valores.
# Ningún valor es obligatorio para arrancar la app: lo que falte aparece como
# "Falta configurar" en Ajustes → Integraciones y bloquea solo la función afectada.

# --- Base de datos (SQLite, persistente) ---
DATABASE_URL=./data/prospect.db

# --- Descubrimiento de empresas ---
# Google Places API (New). Habilita "Places API (New)" en Google Cloud y crea una clave.
# https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=

# OpenStreetMap (Nominatim + Overpass): funciona sin clave. Opcional pero recomendado: tu email o URL,
# que se añade al User-Agent como pide la política de uso de OSM.
OSM_CONTACT=
# Opcional: instancia propia de Overpass.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Opcional: instancia propia de Nominatim.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# --- Análisis web ---
# Opcional. Google PageSpeed Insights funciona sin clave con cuota baja; con clave sube la cuota.
PAGESPEED_API_KEY=

# --- IA (interpretación del análisis, oportunidades, mensajes, informes) ---
# Basta UNA de las dos claves. Si hay ambas se usa Anthropic, salvo que fijes LLM_PROVIDER.
# Anthropic (Claude): https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Google AI Studio (Gemini): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Opcional: anthropic | gemini
LLM_PROVIDER=

# --- Aplicación ---
# Carpeta donde se guardan los PDF de informes.
REPORTS_DIR=./data/reports
# Chromium/Chrome para renderizar el PDF del informe. Vacío = usa el de Playwright o uno del sistema.
# Instalar uno: npx playwright-core install chromium
CHROMIUM_PATH=
# Concurrencia del runner de trabajos en segundo plano.
JOB_CONCURRENCY=2
